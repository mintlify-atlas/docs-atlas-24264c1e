  "keyFeatures": [
    "Role-based access control with three user roles: Administrator, Teacher, and Student",
    "Student enrollment with auto-generated usernames and SHA-256 hashed passwords",
    "Group management with level (Basic/Intermediate/Advanced) and category (Children/Teens) classification",
    "Grade tracking with first partial, second partial, and final average scores",
    "Monthly payment tracking across up to 7 installments per semester period",
    "PDF report generation using JasperReports for student rosters, teacher logs, grade lists, and payment summaries",
    "Excel backup export using Apache POI with formatted spreadsheets for all entities",
    "MySQL database backup via mysqldump integration",
    "Payment calendar with semester period switching (Period A / Period B)",
    "Session management with 30-minute timeout and expiration handling"
  ],
  "publicApiSurface": [
    "POST /addAdmin — Register a new administrator",
    "POST /addGroup — Create a new student group",
    "POST /addStudent — Enroll a new student",
    "POST /addTeacher — Register a new teacher",
    "GET|POST /loginAdmin — Administrator login",
    "GET|POST /loginStudent — Student login",
    "GET|POST /loginTeacher — Teacher login",
    "GET /cerrarSesion — End user session",
    "POST /deleteInformation — Delete a record (user/student/teacher/group)",
    "POST /registerStudent — Student self-registration",
    "GET /reportesServlet — Generate PDF reports (student roster, teacher log, grade list, payment list)",
    "POST /updateGrade — Update student grades",
    "POST /updateInfo — Update personal information",
    "POST /updatePay — Update payment tracking record",
    "POST /updateSchedule — Update payment calendar entry",
    "POST /updateUser — Update user credentials",
    "GET /backupServlet — Export Excel/SQL backup of all data",
    "POST /updatePeriodo — Switch active semester period (A/B)"
  ]
}
